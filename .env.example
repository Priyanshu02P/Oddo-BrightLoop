# === Django Core Settings ===
DEBUG=True
SECRET_KEY=django-insecure-replace-this-with-a-very-long-random-string-for-production
ALLOWED_HOSTS=localhost,127.0.0.1

# === Database (PostgreSQL in production; SQLite is used when unset) ===
# DATABASE_URL=postgres://user:password@host:5432/brightloop

# === Security / deployment (production) ===
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app
# THROTTLE_IP_HEADER=HTTP_X_VERCEL_FORWARDED_FOR

# === Accounts (M1) ===
# PASSWORD_RESET_TIMEOUT=3600

# === Email ===
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DEFAULT_FROM_EMAIL=no-reply@brightloop.example

# === Scheduler (M3 plan auto-close) ===
# CRON_SECRET=replace-with-a-long-random-string
# PLANS_AUTO_CLOSE_HANDLER=apps.subscriptions.tasks.close_plan_subscriptions
