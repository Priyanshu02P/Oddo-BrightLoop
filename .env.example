# === Django Core Settings ===
DEBUG=True
SECRET_KEY=django-insecure-replace-this-with-a-very-long-random-string-for-production
ALLOWED_HOSTS=localhost,127.0.0.1

# === Database (PostgreSQL in production; SQLite is used when unset) ===
# DATABASE_URL=postgres://user:password@host:5432/brightloop

# === Security / deployment (production) ===
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app
# THROTTLE_IP_HEADER=HTTP_X_VERCEL_FORWARDED_FOR

# === Accounts (M1) ===
# PASSWORD_RESET_TIMEOUT=3600

# === Email / SMTP ===
# Local development: run `docker compose up -d mailpit`, then open
# http://localhost:8025 to inspect outgoing messages.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@brightloop.example

# Vercel + Gmail production values (set these in Vercel Environment Variables,
# not in this file or Git). Generate an App Password in your Google Account.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-brightloop-account@gmail.com
# EMAIL_HOST_PASSWORD=your-16-character-google-app-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=BrightLoop <your-brightloop-account@gmail.com>

# === Scheduler (M3 plan auto-close) ===
# CRON_SECRET=replace-with-a-long-random-string
# PLANS_AUTO_CLOSE_HANDLER=apps.subscriptions.tasks.close_plan_subscriptions

# === Subscriptions (M4) ===
# QUOTATION_DEFAULT_VALIDITY_DAYS=30

# === Billing runs (M5) ===
# Subscriptions per batch, and seconds a run may work per request before it
# pauses for the next trigger (keep below the serverless function timeout).
# BILLING_BATCH_SIZE=100
# BILLING_TIME_BUDGET_SECONDS=20

# === Payments (M7) ===
# The simulated test gateway; defaults to DEBUG. Keep it off in production.
# PAYMENT_MOCK_GATEWAY_ENABLED=True
# Overdue reminder cadence in days past due (working assumption), retries per
# reminder, and invoices per batch.
# DUNNING_CADENCE_DAYS=1,7,14
# DUNNING_MAX_ATTEMPTS=3
# DUNNING_BATCH_SIZE=100
