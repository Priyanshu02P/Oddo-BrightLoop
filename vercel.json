{
  "version": 2,
  "builds": [
    {
      "src": "config/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb" }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "config/wsgi.py"
    }
  ],
  "crons": [
    { "path": "/app/subscriptions/cron/daily/", "schedule": "0 1 * * *" },
    { "path": "/app/plans/cron/auto-close/", "schedule": "30 1 * * *" },
    { "path": "/app/billing/cron/run/", "schedule": "0 2 * * *" }
  ]
}
